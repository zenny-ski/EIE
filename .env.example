# ---- Storage ----
EIE_DB_PATH=eie.db
# Calendar used for "today", date filters and dashboard periods (IANA name)
EIE_TIMEZONE=Asia/Kolkata

# NOTE: thresholds, notification recipients, forward teams, reply wording and IndeCab field tiers below are only
# the DEFAULTS. An admin can change them in the GUI (Settings); what is saved there wins over this file.

# ---- Email source: auto | graph | imap ----
# auto = Graph if configured, with IMAP as fallback when Graph fails
EMAIL_SOURCE=auto
FETCH_LIMIT=25
# Read the text of PDF / Word / text / CSV attachments (no OCR) and give it to the classifier as context.
# Set false if attachment contents must not be sent to the AI provider.
ATTACHMENT_TEXT=true
MARK_AS_READ=true
# GUI polls the mailbox in the background every AUTO_FETCH_SECONDS
AUTO_FETCH=true
AUTO_FETCH_SECONDS=8

# ---- Microsoft Graph (app registration, client-credentials flow, Mail.ReadWrite application permission) ----
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=bookings@example.com

# ---- IMAP fallback ----
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---- Classification ----
# USE_LLM=false forces the offline rule-based classifier (confidence capped so it never auto-creates)
USE_LLM=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Regex for booking IDs found in email text (group 1 = the ID if present)
BOOKING_ID_REGEX=\b((?:BK|BKG|IND|SKL|TRP)[-/]?\d{4,})\b

# ---- Confidence thresholds (0-100) ----
CONFIDENCE_HIGH=85
CONFIDENCE_MEDIUM=50
# Optional per-bucket overrides (FR-012); leave blank to use the values above
CONFIDENCE_HIGH_FEEDBACK=
CONFIDENCE_MEDIUM_FEEDBACK=
CONFIDENCE_HIGH_ESCALATION=
CONFIDENCE_MEDIUM_ESCALATION=

# ---- Reply sending ----
# Graph mailbox emails are answered in-thread via Graph (needs the Mail.Send application permission).
# Everything else (IMAP, or Graph without Mail.Send) goes through SMTP. DRY_RUN=true records replies without sending.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Notifications (comma-separated addresses; sent through the same Graph/SMTP route as replies) ----
# NOTIFY_CCP: CCP Module Managers and Executives, told when an email lands in the review queue.
# NOTIFY_BOOKING: told about every New Booking (defaults to NOTIFY_CCP). NOTIFY_ALERTS: ingestion failures (defaults to NOTIFY_CCP).
NOTIFY_CCP=
NOTIFY_BOOKING=
NOTIFY_ALERTS=
# Teams offered by "Forward to team" in the review queue, as Name=address pairs
FORWARD_TEAMS=Invoicing=invoicing@example.com,DMT=dmt@example.com,IT=it@example.com

# ---- Access control ----
# name:role:token, comma-separated. Roles: super_admin, admin, module_manager, executive, escalation_manager.
# Leave empty for no login (everyone is an admin): only do that on your own machine.
EIE_USERS=

# ---- Graph webhook (optional; polling still runs as a fallback) ----
# Any long random string. Needs a PUBLIC_BASE_URL that starts with https:// and is reachable from the internet.
# The GUI then creates the subscription and renews it before it expires (about every 3 days).
GRAPH_WEBHOOK_SECRET=

# ---- Destinations ----
# DRY_RUN=true logs payloads instead of calling the downstream systems
DRY_RUN=true
# Base URL of this GUI; downstream records get a link back to the source email
PUBLIC_BASE_URL=http://127.0.0.1:8000
WHATSAPP_FEEDBACK_URL=
WHATSAPP_FEEDBACK_TOKEN=
ESCALATION_URL=
ESCALATION_TOKEN=
INDECAB_URL=
INDECAB_TOKEN=
